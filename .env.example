# ── 数据库 ──────────────────────────────────────────────
# 默认 SQLite（开箱即用），无需修改。
# 换成 PostgreSQL 后会自动启用 pgvector 向量索引：
# DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/ai_auto

# ── AI 模型（OpenAI 兼容协议）────────────────────────────
OPENAI_API_KEY=
# 如果用的是中转/自建服务，填它的地址，例如 https://api.xxx.com/v1
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini
USE_AI_INSIGHTS=true

# 留空则使用本地哈希向量（离线可用）；填 text-embedding-3-small 则调用 API
EMBEDDING_MODEL=
EMBEDDING_DIM=512

# ── 其它 ────────────────────────────────────────────────
MAX_UPLOAD_MB=50
AUTOMATION_INTERVAL_SECONDS=60
